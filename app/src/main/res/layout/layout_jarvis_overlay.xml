<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- The floating neon tab on the right edge -->
    <TextView
        android:id="@+id/overlayTab"
        android:layout_width="30dp"
        android:layout_height="70dp"
        android:layout_gravity="center_vertical|end"
        android:background="#DD00E5FF"
        android:gravity="center"
        android:text="⚡"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- The expanded command console -->
    <LinearLayout
        android:id="@+id/overlayConsole"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:background="#F0000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAgentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="JARVIS VISION CORE"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAgentCommand"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="#161822"
            android:hint="e.g. Click Subscribe"
            android:imeOptions="actionGo"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRunAgent"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#00E5FF"
                android:text="Execute"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseOverlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Close"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
